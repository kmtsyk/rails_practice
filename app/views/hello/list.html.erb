<table class="table">
  <thead>
    <tr>
      <th>ISBN</th>
      <th>Title</th>
      <th>price</th>
      <th>ISBN</th>
      <th>Publisher</th>
      <th>date</th>
      <th>DL</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.isbn %></td>
        <td><%= book.publisher %></td>
        <td><%= book.price %></td>
        <td><%= book.title %></td>
        <td><%= book.publisher %></td>
        <td><%= book.published %></td>
        <td><%= book.dl %></td>
      </tr>
    <% end %>
  </tbody>
</table>